{
	"name": "docxidian",
	"version": "0.0.4",
	"description": "Open, edit, and save DOCX documents directly inside Obsidian.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint \"src/**/*.{ts,tsx,cjs}\" --max-warnings=0",
		"test:vault": "node scripts/vault-test.mjs",
		"test:rulers": "node scripts/ruler-vault-test.mjs",
		"test:settings": "node scripts/settings-vault-test.mjs",
		"test": "node --test tests/*.test.mjs"
	},
	"keywords": [],
	"license": "0-BSD",
	"devDependencies": {
		"@eslint/js": "9.39.5",
		"@types/node": "22.20.5",
		"@types/react": "18.3.31",
		"@types/react-dom": "18.3.7",
		"esbuild": "0.28.2",
		"eslint": "9.39.5",
		"eslint-plugin-obsidianmd": "0.4.2",
		"globals": "17.13.0",
		"jiti": "2.7.0",
		"obsidian": "1.14.4",
		"tslib": "2.9.1",
		"typescript": "5.9.3",
		"typescript-eslint": "8.72.1"
	},
	"dependencies": {
		"@eigenpal/docx-editor-i18n": "1.9.0",
		"@eigenpal/docx-editor-react": "1.9.0",
		"jszip": "3.10.2",
		"prosemirror-state": "1.4.4",
		"prosemirror-view": "1.42.9",
		"react": "^18.3.1",
		"react-dom": "^18.3.1"
	}
}
